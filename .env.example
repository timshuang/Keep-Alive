# Telegram Bot (required)
# TG_BOT_TOKEN from @BotFather
TG_BOT_TOKEN=
# TG_CHAT_ID for notifications
TG_CHAT_ID=
# Optional TG API proxy, e.g. http://127.0.0.1:7890
TG_API_PROXY=

# Optional Resend email alerts
# RESEND_API_KEY from resend.com
RESEND_API_KEY=
# ALERT_EMAIL for alert emails
ALERT_EMAIL=
