# Hubstudio API
HUB_API_HOST=127.0.0.1
HUB_API_PORT=6873

# Telegram Bot
TG_BOT_TOKEN=
TG_CHAT_ID=
TG_API_PROXY=                   # Optional: HTTP proxy for TG API, e.g. http://127.0.0.1:52022

# Alert Email (optional, set via /set email)
ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Keepalive intervals (days)
GMAIL_INTERVAL=3
TWITTER_INTERVAL=7
DISCORD_INTERVAL=30

# Jitter (days), actual = interval ± jitter
GMAIL_JITTER=1
TWITTER_JITTER=2
DISCORD_JITTER=5

# Scheduling
ACCOUNT_INTERVAL_MIN_SEC=180
ACCOUNT_INTERVAL_MAX_SEC=480
PAGE_WAIT_MIN_SEC=3
PAGE_WAIT_MAX_SEC=8
RANDOM_START_DELAY_MAX_MIN=720

# Watchdog
WATCHDOG_CHECK_INTERVAL_HOURS=6
